AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=airflow-superglm:3.2.1-python3.14
# Generate a production key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret_change_me
AIRFLOW__CORE__LOAD_EXAMPLES=false

MSSQL_SERVER=mssql,1433
MSSQL_DATABASE=PricingLab
MLFLOW_DATABASE=MLflowTracking
MSSQL_SQLALCHEMY_DIALECT=mssql+pyodbc
MSSQL_AUTH_MODE=sql_password
MSSQL_TOKEN_SCOPE=https://database.windows.net/.default
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong(!)Password123
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=no
MSSQL_TRUST_SERVER_CERT=yes
PRICING_SCHEMA=pricing
PRICING_STAGING_SCHEMA=pricing_stg
MLOPS_SCHEMA=mlops

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ALLOWED_HOSTS=localhost,localhost:5000,127.0.0.1,127.0.0.1:5000,mlflow,mlflow:5000
RATING_EXPORT_ROOT=/opt/pricing/state/rating_exports
VALIDATION_SPLIT_ARTIFACT_ROOT=/opt/pricing/state/validation_splits
PRICING_MIGRATIONS_DIR=/opt/pricing/db/migrations
PRICING_SKIP_DATABASE_CREATE=false
