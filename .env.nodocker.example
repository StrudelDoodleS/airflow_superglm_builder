# Host-process Airflow/MLflow setup. Copy to .env and edit before work use.

AIRFLOW_HOME=state/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__DAGS_FOLDER=dags

MSSQL_SERVER=<server-name>.database.windows.net,1433
MSSQL_DATABASE=PricingLab_UAT
MLFLOW_DATABASE=MLflowTracking
MSSQL_USER=pricing_pipeline_writer
MSSQL_PASSWORD=<from-secret-store>
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERT=no

# Set this to true when the target database already exists and the pipeline
# login does not have permission to create databases on the server.
PRICING_SKIP_DATABASE_CREATE=true
PRICING_MIGRATIONS_DIR=db/migrations
PRICING_PROJECT_ROOT=.

MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///state/mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=state/mlflow/artifacts
MLFLOW_ALLOWED_HOSTS=localhost,localhost:5000,127.0.0.1,127.0.0.1:5000

RATING_EXPORT_ROOT=state/rating_exports
